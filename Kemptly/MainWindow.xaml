<Window x:Class="Kemptly.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kemptly" Height="820" Width="1320" MinWidth="1040" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/Kemptly.ico">
    <Window.Resources>
        <Style x:Key="NavIcon" TargetType="TextBlock" BasedOn="{StaticResource Icon}">
            <Setter Property="Margin" Value="4,0,14,0"/>
        </Style>
        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Padding" Value="10,9"/>
            <Setter Property="Margin" Value="0,1"/>
        </Style>
        <Style x:Key="VersionLink" TargetType="Hyperlink">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="TextDecorations" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                    <Setter Property="TextDecorations" Value="Underline"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Grid Grid.Column="0" Margin="8,10,6,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Margin="12,6,0,18">
                <Image Source="pack://application:,,,/Assets/logo.png" Width="32" Height="32"
                       RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Kemptly" FontSize="21" FontWeight="SemiBold" LineHeight="24"/>
                    <!-- Version number; opens the project's GitHub page -->
                    <TextBlock FontSize="12" Margin="1,0,0,0">
                        <Hyperlink x:Name="VersionLink" Click="Version_Click" Style="{StaticResource VersionLink}"
                                   ToolTip="Open Kemptly on GitHub">
                            <Run x:Name="VersionText" Text="v1.0.0"/><Run Text="  ·  GitHub"/>
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
            </StackPanel>

            <ListBox x:Name="Nav" Grid.Row="1" SelectionChanged="Nav_SelectionChanged"
                     BorderThickness="0" Background="Transparent">
                <ListBoxItem Tag="dashboard"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" Style="{StaticResource NavIcon}"/><TextBlock Text="Dashboard"/></StackPanel></ListBoxItem>
                <ListBoxItem Tag="cleaner"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" Style="{StaticResource NavIcon}"/><TextBlock Text="Junk Cleaner"/></StackPanel></ListBoxItem>
                <ListBoxItem Tag="disk"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xEDA2;" Style="{StaticResource NavIcon}"/><TextBlock Text="Disk Analyzer"/></StackPanel></ListBoxItem>
                <ListBoxItem Tag="apps"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE71D;" Style="{StaticResource NavIcon}"/><TextBlock Text="Installed Apps"/></StackPanel></ListBoxItem>
                <ListBoxItem Tag="startup"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7E8;" Style="{StaticResource NavIcon}"/><TextBlock Text="Startup"/></StackPanel></ListBoxItem>
                <ListBoxItem Tag="processes"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D9;" Style="{StaticResource NavIcon}"/><TextBlock Text="Processes"/></StackPanel></ListBoxItem>
                <ListBoxItem Tag="services"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE912;" Style="{StaticResource NavIcon}"/><TextBlock Text="Services"/></StackPanel></ListBoxItem>
                <ListBoxItem Tag="network"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE968;" Style="{StaticResource NavIcon}"/><TextBlock Text="Network"/></StackPanel></ListBoxItem>
                <ListBoxItem Tag="security"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xEA18;" Style="{StaticResource NavIcon}"/><TextBlock Text="Security Scan"/></StackPanel></ListBoxItem>
                <ListBoxItem Tag="tools"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE90F;" Style="{StaticResource NavIcon}"/><TextBlock Text="Tools"/></StackPanel></ListBoxItem>
            </ListBox>

            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="AdminIcon" Text="&#xE7EF;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                        <TextBlock x:Name="AdminTitle" FontWeight="SemiBold"/>
                    </StackPanel>
                    <TextBlock x:Name="AdminText" Style="{StaticResource Subtle}" FontSize="12" Margin="0,4,0,0"/>
                    <Button x:Name="ElevateBtn" Content="Restart as administrator" Margin="0,10,0,0"
                            HorizontalAlignment="Stretch" Click="Elevate_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Page host -->
        <Border Grid.Column="1" Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1,1,0,0" CornerRadius="8,0,0,0">
            <ContentControl x:Name="Host" Margin="28,20,28,18" Focusable="False"/>
        </Border>
    </Grid>
</Window>
