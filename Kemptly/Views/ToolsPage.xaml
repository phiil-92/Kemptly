<UserControl x:Class="Kemptly.Views.ToolsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Tools" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource Subtle}"
                       Text="One-click fixes and maintenance. Items marked with a shield ask for administrator permission when you run them."/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ItemsControl x:Name="ToolList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Columns="3" Margin="0,0,-12,0"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Icon}" Style="{StaticResource Icon}" FontSize="18" Margin="0,0,10,0"
                                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15"/>
                                        <TextBlock Text="&#xEA18;" Style="{StaticResource Icon}" FontSize="12" Margin="8,0,0,0"
                                                   Visibility="{Binding NeedsAdmin, Converter={StaticResource BoolVis}}"
                                                   ToolTip="Asks for administrator permission"/>
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Text="{Binding Description}" Style="{StaticResource Subtle}" FontSize="12" Margin="0,6,0,12"/>
                                    <Button Grid.Row="2" Content="{Binding ButtonText}" Click="Run_Click" HorizontalAlignment="Left" Padding="14,5"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Windows tools" Style="{StaticResource SectionTitle}" Margin="0,8,0,10"/>
                <WrapPanel x:Name="LinkPanel"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12" Margin="0,12,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Output" Style="{StaticResource CardLabel}" Margin="0,0,0,6"/>
                <TextBox x:Name="LogBox" Grid.Row="1" Height="110" IsReadOnly="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" FontSize="12"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
