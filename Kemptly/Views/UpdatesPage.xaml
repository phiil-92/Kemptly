<UserControl x:Class="Kemptly.Views.UpdatesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="App Updates" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource Subtle}"
                       Text="Outdated programs are one of the most common security holes. Kemptly uses winget, which is built into Windows, to find and install updates. It only goes online when you click Check for updates."/>
        </StackPanel>

        <WrapPanel Grid.Row="1" Style="{StaticResource Toolbar}">
            <Button x:Name="CheckBtn" Click="Check_Click" Padding="14,6" Margin="0,0,8,0" Style="{DynamicResource AccentButtonStyle}"
                    AutomationProperties.Name="Check for updates">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE895;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0"/>
                    <TextBlock Text="Check for updates"/>
                </StackPanel>
            </Button>
            <Button x:Name="UpdateAllBtn" Content="Update all" Click="UpdateAll_Click" Padding="14,6" Margin="0,0,16,0" IsEnabled="False"/>
            <ProgressBar x:Name="Busy" Width="120" IsIndeterminate="True" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock x:Name="ProgressText" Style="{StaticResource Subtle}" VerticalAlignment="Center"/>
        </WrapPanel>

        <Grid Grid.Row="2">
            <Border x:Name="EmptyState" Style="{StaticResource Card}" VerticalAlignment="Top" Padding="24">
                <StackPanel>
                    <TextBlock x:Name="EmptyTitle" Text="Not checked yet" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock x:Name="EmptyText" Style="{StaticResource Subtle}" Margin="0,4,0,0"
                               Text="Click Check for updates. winget asks the Microsoft package catalog which of your programs have newer versions."/>
                </StackPanel>
            </Border>
            <DataGrid x:Name="UpdateGrid" Visibility="Collapsed" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="None" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="App" Binding="{Binding Name}" Width="2*" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="Installed" Binding="{Binding Current}" Width="*" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="Available" Binding="{Binding Available}" Width="*" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="1.5*">
                        <DataGridTextColumn.ElementStyle>
                            <!-- Error texts can be long: hovering shows the whole message -->
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CellText}">
                                <Setter Property="ToolTip" Value="{Binding Status}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="">
                                        <Setter Property="ToolTip" Value="{x:Null}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Width="100" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Update" Click="Update_Click" Padding="10,3" FontSize="12" VerticalAlignment="Center"
                                        IsEnabled="{Binding CanUpdate}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <TextBlock Grid.Row="3" Style="{StaticResource Subtle}" Margin="0,10,0,0" FontSize="12"
                   Text="Some installers show a Windows permission prompt (UAC). Updates are downloaded from the app makers via the winget catalog."/>
    </Grid>
</UserControl>
