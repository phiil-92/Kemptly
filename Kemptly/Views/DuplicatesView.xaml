<UserControl x:Class="Kemptly.Views.DuplicatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="0,12,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Style="{StaticResource Subtle}"
                   Text="Finds files with exactly the same content, even if their names differ. In each group one copy is kept (ticked boxes get deleted)."/>
        <Grid Grid.Row="1" Margin="0,12,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="PathBox" VerticalContentAlignment="Center"/>
            <Button Grid.Column="1" Content="Browse…" Click="Browse_Click" Margin="8,0,0,0" Padding="12,6"/>
            <TextBlock Grid.Column="2" Text="Min size (MB)" VerticalAlignment="Center" Margin="16,0,8,0"/>
            <TextBox x:Name="MinSizeBox" Grid.Column="3" Width="60" Text="1" VerticalContentAlignment="Center"/>
            <Button x:Name="ScanBtn" Grid.Column="4" Content="Find duplicates" Click="Scan_Click" Margin="8,0,0,0" Padding="16,6"
                    Style="{DynamicResource AccentButtonStyle}"/>
        </Grid>
        <WrapPanel Grid.Row="2" Margin="0,0,0,8">
            <Button x:Name="DeleteBtn" Content="Delete ticked copies" Click="Delete_Click" Padding="14,6" Margin="0,0,12,0" IsEnabled="False"/>
            <CheckBox x:Name="RecycleCheck" Content="To the Recycle Bin" VerticalAlignment="Center" Margin="0,0,16,0"/>
            <ProgressBar x:Name="Busy" Width="120" IsIndeterminate="True" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock x:Name="ProgressText" Style="{StaticResource Subtle}" VerticalAlignment="Center"/>
        </WrapPanel>
        <ListBox x:Name="GroupList" Grid.Row="3" HorizontalContentAlignment="Stretch" BorderThickness="0" Background="Transparent"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.ScrollUnit="Pixel">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,0,0,8"/>
                    <Setter Property="Focusable" Value="False"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Padding="14,10">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,120,0"/>
                                <TextBlock Text="{Binding WastedText}" HorizontalAlignment="Right" Foreground="{DynamicResource SystemFillColorCautionBrush}"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Files}" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{Binding Delete, UpdateSourceTrigger=PropertyChanged}" ToolTip="Delete this copy" VerticalAlignment="Center" MinWidth="0" Margin="0,0,6,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding FullPath}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Modified, StringFormat=d}" Style="{StaticResource Subtle}" VerticalAlignment="Center" Margin="12,0"/>
                                            <Button Grid.Column="3" Content="Show" Click="Show_Click" Padding="8,1" FontSize="12"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="StatusText" Grid.Row="4" Style="{StaticResource Subtle}" Margin="0,8,0,0"/>
    </Grid>
</UserControl>
