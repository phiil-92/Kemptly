<UserControl x:Class="Kemptly.Views.CleanerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Junk Cleaner" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource Subtle}"
                       Text="Finds caches, temp files and leftovers that are safe to delete. Scan first, review the list, then clean."/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,16,0,12">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="ScanBtn" Click="Scan_Click" Padding="14,6" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0"/>
                        <TextBlock Text="Scan"/>
                    </StackPanel>
                </Button>
                <Button x:Name="CleanBtn" Click="Clean_Click" Padding="14,6" Margin="0,0,16,0" IsEnabled="False"
                        Style="{DynamicResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0"/>
                        <TextBlock Text="Clean selected"/>
                    </StackPanel>
                </Button>
                <ProgressBar x:Name="Busy" Width="140" IsIndeterminate="True" Visibility="Collapsed" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock x:Name="TotalText" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Right" Text="–"/>
                <TextBlock Style="{StaticResource Subtle}" Text="selected to free" HorizontalAlignment="Right"/>
            </StackPanel>
        </Grid>

        <DataGrid x:Name="CatGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="None" SelectionMode="Single"
                  CanUserResizeRows="False" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="48" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                      VerticalAlignment="Center" HorizontalAlignment="Center" MinWidth="0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Category" Width="*" SortMemberPath="Name">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                    <Border Visibility="{Binding ShowAdminNote, Converter={StaticResource BoolVis}}"
                                            Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                                            CornerRadius="4" Padding="6,0" Margin="8,0,0,0">
                                        <TextBlock Text="needs admin" FontSize="11"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding Description}" Style="{StaticResource Subtle}" FontSize="12" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" SortMemberPath="Size" Width="100" ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="Files" Binding="{Binding Files}" Width="80" ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="200">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTemplateColumn Width="80" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Open" Click="Open_Click" Padding="10,3" FontSize="12" VerticalAlignment="Center"
                                    ToolTip="Open this folder in Explorer"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="StatusText" Grid.Row="3" Style="{StaticResource Subtle}" Margin="0,10,0,0"
                   Text="Tip: close your browsers before cleaning their caches."/>
    </Grid>
</UserControl>
