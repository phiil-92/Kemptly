<UserControl x:Class="Kemptly.Views.AppsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Kemptly.Views">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="Installed Apps" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource Subtle}"
                       Text="Programs on this PC. Sort by size to find the big ones you no longer use, and remove the extras Windows came with."/>
        </StackPanel>

        <TabControl Grid.Row="1">
            <TabItem Header="Desktop programs">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <WrapPanel Margin="0,12,0,12">
                        <TextBox x:Name="SearchBox" Width="260" TextChanged="Search_TextChanged" Margin="0,0,12,0" ToolTip="Search apps or publishers"/>
                        <Button Content="Refresh" Click="Refresh_Click" Padding="14,6" Margin="0,0,8,0"/>
                        <Button Content="Store apps (Settings)" Click="StoreApps_Click" Padding="14,6"/>
                    </WrapPanel>

                    <DataGrid x:Name="AppGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="None" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Name" Width="2*" SortMemberPath="Name">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,6">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Publisher}" Style="{StaticResource Subtle}" FontSize="12"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="120" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" SortMemberPath="Size" Width="90" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="Installed" Binding="{Binding DateText}" SortMemberPath="InstallDate" Width="100" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="For" Binding="{Binding Scope}" Width="130" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTemplateColumn Width="170" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="Folder" Click="Folder_Click" Padding="8,2" FontSize="12" Margin="0,0,4,0"/>
                                            <Button Content="Uninstall" Click="Uninstall_Click" Padding="8,2" FontSize="12"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock x:Name="StatusText" Grid.Row="2" Style="{StaticResource Subtle}" Margin="0,10,0,0"/>
                </Grid>
            </TabItem>
            <TabItem Header="Preinstalled extras">
                <local:BloatwareView/>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
