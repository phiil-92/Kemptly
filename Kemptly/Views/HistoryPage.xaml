<UserControl x:Class="Kemptly.Views.HistoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="History" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource Subtle}"
                       Text="Everything Kemptly has changed on this PC, newest first. Use Undo to reverse a change where possible."/>
        </StackPanel>

        <WrapPanel Grid.Row="1" Style="{StaticResource Toolbar}">
            <Button Content="Clear history" Click="Clear_Click" Padding="14,6" Margin="0,0,16,0"/>
            <TextBlock x:Name="StatusText" Style="{StaticResource Subtle}" VerticalAlignment="Center"/>
        </WrapPanel>

        <Grid Grid.Row="2">
            <Border x:Name="EmptyState" Style="{StaticResource Card}" VerticalAlignment="Top" Padding="24">
                <StackPanel>
                    <TextBlock Text="No changes yet" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock Style="{StaticResource Subtle}" Margin="0,4,0,0"
                               Text="When you clean files, disable startup apps, change services or privacy settings, it shows up here."/>
                </StackPanel>
            </Border>
            <DataGrid x:Name="HistoryGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="None" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="When" Binding="{Binding TimeText}" SortMemberPath="Time" Width="140" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTemplateColumn Header="Change" Width="*" SortMemberPath="Title">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,6">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Subtle}" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="" Binding="{Binding StateText}" Width="70" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTemplateColumn Width="170" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="{Binding UndoText}" Click="Undo_Click" Padding="10,3" FontSize="12" VerticalAlignment="Center"
                                        HorizontalAlignment="Left" Visibility="{Binding CanUndo, Converter={StaticResource BoolVis}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>
