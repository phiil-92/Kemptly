<UserControl x:Class="Kemptly.Views.PrivacyPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Privacy" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource Subtle}"
                       Text="Switch off Windows tracking, ads and nagging. Each switch is reversible: turn it off again to restore the Windows default, or undo it on the History page."/>
        </StackPanel>

        <WrapPanel Grid.Row="1" Style="{StaticResource Toolbar}">
            <Button Content="Apply all recommended" Click="ApplyAll_Click" Padding="14,6" Margin="0,0,8,0" Style="{DynamicResource AccentButtonStyle}"/>
            <Button Content="Refresh" Click="Refresh_Click" Padding="14,6"/>
        </WrapPanel>

        <ListBox x:Name="TweakList" Grid.Row="2" HorizontalContentAlignment="Stretch" BorderThickness="0" Background="Transparent"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,0,0,8"/>
                    <Setter Property="Focusable" Value="False"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                    <Border Visibility="{Binding ShowAdminNote, Converter={StaticResource BoolVis}}"
                                            Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                                            CornerRadius="4" Padding="6,0" Margin="8,0,0,0">
                                        <TextBlock Text="needs admin" FontSize="11"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding Description}" Style="{StaticResource Subtle}" FontSize="13" Margin="0,2,0,0"/>
                                <TextBlock Text="{Binding Note}" Style="{StaticResource Subtle}" FontSize="12" FontStyle="Italic" Margin="0,2,0,0"
                                           Visibility="{Binding HasNote, Converter={StaticResource BoolVis}}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" IsChecked="{Binding Applied, Mode=OneWay}" Click="Toggle_Click"
                                      Content="On" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock x:Name="StatusText" Grid.Row="3" Style="{StaticResource Subtle}" Margin="0,10,0,0"/>
    </Grid>
</UserControl>
