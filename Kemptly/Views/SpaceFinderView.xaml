<UserControl x:Class="Kemptly.Views.SpaceFinderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="0,12,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Style="{StaticResource Subtle}"
                   Text="Big space users the Junk Cleaner doesn't touch: system files, restore points, old Windows installations, Linux/Docker disks and node_modules folders."/>
        <WrapPanel Grid.Row="1" Margin="0,12,0,12">
            <Button x:Name="ScanBtn" Content="Find space" Click="Scan_Click" Padding="16,6" Margin="0,0,16,0" Style="{DynamicResource AccentButtonStyle}"/>
            <ProgressBar x:Name="Busy" Width="120" IsIndeterminate="True" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock x:Name="ProgressText" Style="{StaticResource Subtle}" VerticalAlignment="Center"/>
        </WrapPanel>
        <ListBox x:Name="ItemList" Grid.Row="2" HorizontalContentAlignment="Stretch" BorderThickness="0" Background="Transparent"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,0,0,8"/>
                    <Setter Property="Focusable" Value="False"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding SizeText}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Description}" Style="{StaticResource Subtle}" FontSize="12" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="2" Content="{Binding ActionText}" Click="Action_Click" Padding="12,4" VerticalAlignment="Center"
                                    Visibility="{Binding HasAction, Converter={StaticResource BoolVis}}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
