<UserControl x:Class="Kemptly.Views.StartupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Startup" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource Subtle}"
                       Text="Stop programs from launching when you sign in. Unticking an entry disables it (just like Task Manager) — you can turn it back on any time."/>
        </StackPanel>

        <WrapPanel Grid.Row="1" Style="{StaticResource Toolbar}">
            <Button Content="Refresh" Click="Refresh_Click" Padding="14,6" Margin="0,0,16,0"/>
            <CheckBox x:Name="ShowMsTasks" Content="Show Windows (Microsoft) tasks" Click="Filter_Click" VerticalAlignment="Center" Margin="0,0,16,0"/>
            <CheckBox x:Name="OnlyLogonTasks" Content="Only tasks that run at startup/logon" Click="Filter_Click" VerticalAlignment="Center"/>
            <ProgressBar x:Name="Busy" Width="120" IsIndeterminate="True" Visibility="Collapsed" Margin="16,0,0,0" VerticalAlignment="Center"/>
        </WrapPanel>

        <TabControl Grid.Row="2">
            <TabItem x:Name="AppsTab" Header="Startup apps">
                <DataGrid x:Name="StartupGrid" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,8,0,0"
                          HeadersVisibility="Column" GridLinesVisibility="None" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="On" Width="56" SortMemberPath="Enabled">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding Enabled, Mode=OneWay}" Click="StartupToggle_Click"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Name" Width="1.3*" SortMemberPath="DisplayName">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,6">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Publisher}" Style="{StaticResource Subtle}" FontSize="12"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Status" Binding="{Binding StateText}" Width="80" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="190" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="Command" Binding="{Binding Command}" Width="2*" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTemplateColumn Width="150" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Show" Click="StartupShow_Click" Padding="8,2" FontSize="12" Margin="0,0,4,0"/>
                                        <Button Content="Remove" Click="StartupRemove_Click" Padding="8,2" FontSize="12"
                                                ToolTip="Delete this startup entry entirely"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Scheduled tasks">
                <DataGrid x:Name="TaskGrid" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,8,0,0"
                          HeadersVisibility="Column" GridLinesVisibility="None" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="On" Width="56" SortMemberPath="Enabled">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding Enabled, Mode=OneWay}" Click="TaskToggle_Click"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Task" Width="1.4*" SortMemberPath="Name">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,6">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding FolderPath}" Style="{StaticResource Subtle}" FontSize="12"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Runs" Binding="{Binding Triggers}" Width="150" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="Last run" Binding="{Binding LastRun}" Width="130" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="2*" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTemplateColumn Width="70" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Show" Click="TaskShow_Click" Padding="8,2" FontSize="12" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <TextBlock x:Name="StatusText" Grid.Row="3" Style="{StaticResource Subtle}" Margin="0,10,0,0"/>
    </Grid>
</UserControl>
