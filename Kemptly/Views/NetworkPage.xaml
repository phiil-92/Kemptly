<UserControl x:Class="Kemptly.Views.NetworkPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Network" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource Subtle}"
                       Text="Which programs are talking to the internet right now. Watch out for unsigned programs you don't recognise."/>
        </StackPanel>

        <WrapPanel Grid.Row="1" Style="{StaticResource Toolbar}">
            <TextBox x:Name="SearchBox" Width="220" TextChanged="Filter_Changed" Margin="0,0,12,0" ToolTip="Filter by process, address or host"/>
            <CheckBox x:Name="OnlyInternet" Content="Only internet connections" IsChecked="True" Click="Filter_Changed" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <CheckBox x:Name="ShowListening" Content="Show listening ports" Click="Filter_Changed" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <CheckBox x:Name="AutoCheck" Content="Live update" Click="Auto_Click" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Button Content="Refresh" Click="Refresh_Click" Padding="14,6"/>
        </WrapPanel>

        <DataGrid x:Name="ConnGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="None" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Process" Binding="{Binding Process}" Width="1.1*" ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="65" ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="Remote address" Binding="{Binding Remote}" Width="1.3*" ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="Remote host" Binding="{Binding RemoteHost}" Width="1.5*" ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="State" Binding="{Binding State}" Width="95" ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="Local" Binding="{Binding Local}" Width="1*" ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="Signed by" Binding="{Binding Signed}" Width="1.2*" ElementStyle="{StaticResource CellText}"/>
                <DataGridTemplateColumn Width="250" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Show" Click="Show_Click" Padding="8,2" FontSize="12" Margin="0,2,4,2"/>
                                <Button Content="End task" Click="Kill_Click" Padding="8,2" FontSize="12" Margin="0,2,4,2"/>
                                <Button Content="Block" Click="Block_Click" Padding="8,2" FontSize="12" Margin="0,2"
                                        ToolTip="Block this program from the internet with a Windows Firewall rule"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="StatusText" Grid.Row="3" Style="{StaticResource Subtle}" Margin="0,10,0,0"/>

        <Expander x:Name="BlockedExpander" Grid.Row="4" Margin="0,10,0,0" Header="Programs blocked by Kemptly">
            <ItemsControl x:Name="BlockedList" Margin="0,6,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding AppName}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Program}" Style="{StaticResource Subtle}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Unblock" Click="Unblock_Click" Padding="10,3" FontSize="12" VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Expander>
    </Grid>
</UserControl>
