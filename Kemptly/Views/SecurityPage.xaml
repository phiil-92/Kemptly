<UserControl x:Class="Kemptly.Views.SecurityPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Kemptly.Views">
    <UserControl.Resources>
        <Style x:Key="StatusCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="Padding" Value="14,12"/>
        </Style>
        <Style x:Key="RowBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Security Scan" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource Subtle}"
                       Text="Looks for signs of malware: programs in odd places, disguised files, startup and task tricks, hijacked settings and weakened protection. It complements - doesn't replace - your antivirus."/>
        </StackPanel>

        <TabControl Grid.Row="1" Margin="0,12,0,0">
            <TabItem Header="Security check">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0" Margin="0,12,0,12">
                        <Button x:Name="ScanBtn" Click="Scan_Click" Padding="14,6" Margin="0,0,8,0" Style="{DynamicResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xEA18;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0"/>
                                <TextBlock Text="Run security check"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="QuickScanBtn" Content="Defender quick scan" Click="QuickScan_Click" Padding="14,6" Margin="0,0,8,0"/>
                        <Button x:Name="FullScanBtn" Content="Defender full scan" Click="FullScan_Click" Padding="14,6" Margin="0,0,8,0"/>
                        <Button x:Name="UpdateBtn" Content="Update definitions" Click="Update_Click" Padding="14,6" Margin="0,0,8,0"/>
                        <Button Content="Windows Security" Click="OpenWinSec_Click" Padding="14,6" Margin="0,0,16,0"/>
                        <ProgressBar x:Name="Busy" Width="120" IsIndeterminate="True" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock x:Name="ProgressText" Style="{StaticResource Subtle}" VerticalAlignment="Center"/>
                    </WrapPanel>

                    <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,-12,14">
                        <Border Style="{StaticResource StatusCard}">
                            <StackPanel>
                                <TextBlock Text="Antivirus" Style="{StaticResource CardLabel}"/>
                                <TextBlock x:Name="AvText" Text="Not checked" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatusCard}">
                            <StackPanel>
                                <TextBlock Text="Virus definitions" Style="{StaticResource CardLabel}"/>
                                <TextBlock x:Name="DefText" Text="Not checked" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatusCard}">
                            <StackPanel>
                                <TextBlock Text="Firewall" Style="{StaticResource CardLabel}"/>
                                <TextBlock x:Name="FwText" Text="Not checked" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatusCard}">
                            <StackPanel>
                                <TextBlock Text="User Account Control" Style="{StaticResource CardLabel}"/>
                                <TextBlock x:Name="UacText" Text="Not checked" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Grid Grid.Row="2">
                        <Border x:Name="EmptyState" Style="{StaticResource Card}" VerticalAlignment="Top" Padding="24">
                            <StackPanel>
                                <TextBlock x:Name="EmptyTitle" Text="No scan yet" FontSize="17" FontWeight="SemiBold"/>
                                <TextBlock x:Name="EmptyText" Style="{StaticResource Subtle}" Margin="0,4,0,0"
                                           Text="Press “Run security check”. It takes about 10–30 seconds and changes nothing on its own."/>
                            </StackPanel>
                        </Border>
                        <ListBox x:Name="FindingList" Visibility="Collapsed" HorizontalContentAlignment="Stretch"
                                 BorderThickness="0" Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,8"/>
                                    <Setter Property="Focusable" Value="False"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Padding="14,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="82"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource SeverityPill}">
                                                <TextBlock Text="{Binding SeverityText}" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock TextWrapping="Wrap">
                                                    <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold"/>
                                                    <Run Text="  ·  " Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                    <Run Text="{Binding Category, Mode=OneWay}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Subtle}" Margin="0,4,0,0"/>
                                                <TextBlock Text="{Binding Path}" Visibility="{Binding HasPath, Converter={StaticResource BoolVis}}"
                                                           FontFamily="Cascadia Mono, Consolas" FontSize="12" Margin="0,4,0,0"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
                                                <WrapPanel Margin="0,8,0,0">
                                                    <Button Content="Show file" Click="Show_Click" Style="{StaticResource RowBtn}"
                                                            Visibility="{Binding HasPath, Converter={StaticResource BoolVis}}"/>
                                                    <Button Content="End process" Click="Kill_Click" Style="{StaticResource RowBtn}"
                                                            Visibility="{Binding HasPid, Converter={StaticResource BoolVis}}"/>
                                                    <Button Content="Disable startup" Click="DisableStartup_Click" Style="{StaticResource RowBtn}"
                                                            Visibility="{Binding CanDisableStartup, Converter={StaticResource BoolVis}}"/>
                                                    <Button Content="Disable task" Click="DisableTask_Click" Style="{StaticResource RowBtn}"
                                                            Visibility="{Binding CanDisableTask, Converter={StaticResource BoolVis}}"/>
                                                    <Button Content="Delete file" Click="Delete_Click" Style="{StaticResource RowBtn}"
                                                            Visibility="{Binding CanDeleteFile, Converter={StaticResource BoolVis}}"/>
                                                    <Button Content="Scan with Defender" Click="ScanFile_Click" Style="{StaticResource RowBtn}"
                                                            Visibility="{Binding HasPath, Converter={StaticResource BoolVis}}"/>
                                                    <Button Content="Dismiss" Click="Dismiss_Click" Style="{StaticResource RowBtn}"/>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="Browser extensions">
                <local:ExtensionsView/>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
