<UserControl x:Class="Kemptly.Views.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Tile" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="0,0,12,12"/>
        </Style>
        <Style x:Key="ActionBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="MinWidth" Value="200"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Dashboard" Style="{StaticResource PageTitle}"/>
            <TextBlock x:Name="OsText" Style="{StaticResource Subtle}" Margin="0,0,0,18"/>

            <UniformGrid Columns="4" Margin="0,0,-12,0">
                <Border Style="{StaticResource Tile}">
                    <StackPanel>
                        <TextBlock Text="CPU" Style="{StaticResource CardLabel}"/>
                        <TextBlock x:Name="CpuValue" Text="–" Style="{StaticResource BigValue}"/>
                        <ProgressBar x:Name="CpuBar" Maximum="100" Margin="0,8,0,8"/>
                        <TextBlock x:Name="CpuName" Style="{StaticResource Subtle}" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Tile}">
                    <StackPanel>
                        <TextBlock Text="Memory" Style="{StaticResource CardLabel}"/>
                        <TextBlock x:Name="MemValue" Text="–" Style="{StaticResource BigValue}"/>
                        <ProgressBar x:Name="MemBar" Maximum="100" Margin="0,8,0,8"/>
                        <TextBlock x:Name="MemDetail" Style="{StaticResource Subtle}" FontSize="12"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Tile}">
                    <StackPanel>
                        <TextBlock Text="Uptime" Style="{StaticResource CardLabel}"/>
                        <TextBlock x:Name="UptimeValue" Text="–" Style="{StaticResource BigValue}"/>
                        <TextBlock x:Name="UptimeDetail" Style="{StaticResource Subtle}" FontSize="12" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Tile}">
                    <StackPanel>
                        <TextBlock Text="Processes" Style="{StaticResource CardLabel}"/>
                        <TextBlock x:Name="ProcValue" Text="–" Style="{StaticResource BigValue}"/>
                        <TextBlock x:Name="StartupDetail" Style="{StaticResource Subtle}" FontSize="12" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <TextBlock Text="Drives" Style="{StaticResource SectionTitle}" Margin="0,10,0,10"/>
            <ItemsControl x:Name="DrivesList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="2" Margin="0,0,-12,0"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xEDA2;" Style="{StaticResource Icon}" FontSize="28" Margin="0,0,16,0"/>
                                <StackPanel Grid.Column="1">
                                    <Grid>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding PercentText}" HorizontalAlignment="Right" Style="{StaticResource Subtle}"/>
                                    </Grid>
                                    <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" Margin="0,8,0,6"/>
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Subtle}" FontSize="12"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Physical disks" Style="{StaticResource SectionTitle}" Margin="0,10,0,10"/>
            <ItemsControl x:Name="DisksList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="16,10">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Subtle}" FontSize="12"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Health}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="DisksStatus" Style="{StaticResource Subtle}" Text="Reading disk health…"/>

            <TextBlock Text="Quick actions" Style="{StaticResource SectionTitle}"/>
            <WrapPanel>
                <Button Style="{StaticResource ActionBtn}" Click="QuickClean_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="20" Margin="0,0,12,0"/>
                        <StackPanel><TextBlock Text="Scan for junk" FontWeight="SemiBold"/><TextBlock Text="Temp files, caches, leftovers" Style="{StaticResource Subtle}" FontSize="12"/></StackPanel>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ActionBtn}" Click="QuickSecurity_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEA18;" Style="{StaticResource Icon}" FontSize="20" Margin="0,0,12,0"/>
                        <StackPanel><TextBlock Text="Security check" FontWeight="SemiBold"/><TextBlock Text="Look for suspicious activity" Style="{StaticResource Subtle}" FontSize="12"/></StackPanel>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ActionBtn}" Click="QuickDisk_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEDA2;" Style="{StaticResource Icon}" FontSize="20" Margin="0,0,12,0"/>
                        <StackPanel><TextBlock Text="Find big files" FontWeight="SemiBold"/><TextBlock Text="See what fills your drive" Style="{StaticResource Subtle}" FontSize="12"/></StackPanel>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ActionBtn}" Click="QuickStartup_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7E8;" Style="{StaticResource Icon}" FontSize="20" Margin="0,0,12,0"/>
                        <StackPanel><TextBlock Text="Speed up startup" FontWeight="SemiBold"/><TextBlock Text="Disable apps that auto-start" Style="{StaticResource Subtle}" FontSize="12"/></StackPanel>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ActionBtn}" Click="QuickUpdates_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE895;" Style="{StaticResource Icon}" FontSize="20" Margin="0,0,12,0"/>
                        <StackPanel><TextBlock Text="Update apps" FontWeight="SemiBold"/><TextBlock Text="Find outdated programs" Style="{StaticResource Subtle}" FontSize="12"/></StackPanel>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ActionBtn}" Click="QuickReport_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8A5;" Style="{StaticResource Icon}" FontSize="20" Margin="0,0,12,0"/>
                        <StackPanel><TextBlock Text="Export PC report" FontWeight="SemiBold"/><TextBlock Text="Summary to share for help" Style="{StaticResource Subtle}" FontSize="12"/></StackPanel>
                    </StackPanel>
                </Button>
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
