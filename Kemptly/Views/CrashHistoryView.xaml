<UserControl x:Class="Kemptly.Views.CrashHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="0,12,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Style="{StaticResource Subtle}"
                   Text="Blue screens, unexpected shutdowns and app crashes from the last 30 days, explained in plain language. Read from the Windows event logs."/>
        <WrapPanel Grid.Row="1" Margin="0,12,0,12">
            <Button Content="Refresh" Click="Refresh_Click" Padding="14,6" Margin="0,0,8,0"/>
            <Button Content="Open Reliability Monitor" Click="Reliability_Click" Padding="14,6"/>
        </WrapPanel>
        <UniformGrid Grid.Row="2" Columns="3" Margin="0,0,-12,12">
            <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="14,10">
                <StackPanel>
                    <TextBlock Text="Blue screens" Style="{StaticResource CardLabel}"/>
                    <TextBlock x:Name="BsodCount" Text="–" Style="{StaticResource BigValue}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="14,10">
                <StackPanel>
                    <TextBlock Text="Unexpected shutdowns" Style="{StaticResource CardLabel}"/>
                    <TextBlock x:Name="ShutdownCount" Text="–" Style="{StaticResource BigValue}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="14,10">
                <StackPanel>
                    <TextBlock Text="App crashes and freezes" Style="{StaticResource CardLabel}"/>
                    <TextBlock x:Name="AppCount" Text="–" Style="{StaticResource BigValue}"/>
                    <TextBlock x:Name="TopApp" Style="{StaticResource Subtle}" FontSize="12"/>
                </StackPanel>
            </Border>
        </UniformGrid>
        <DataGrid x:Name="CrashGrid" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="None" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="When" Binding="{Binding TimeText}" SortMemberPath="Time" Width="140" ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="Type" Binding="{Binding KindText}" Width="150" ElementStyle="{StaticResource CellText}"/>
                <DataGridTemplateColumn Header="What happened" Width="*" SortMemberPath="Title">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,6">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Subtle}" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
