<UserControl x:Class="Kemptly.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource Subtle}" Text="Settings are saved on this PC only."/>

            <TextBlock Text="Appearance" Style="{StaticResource SectionTitle}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Theme" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <RadioButton x:Name="ThemeSystem" Content="Same as Windows" GroupName="theme" Margin="0,0,20,0" Click="Theme_Click"/>
                        <RadioButton x:Name="ThemeLight" Content="Light" GroupName="theme" Margin="0,0,20,0" Click="Theme_Click"/>
                        <RadioButton x:Name="ThemeDark" Content="Dark" GroupName="theme" Click="Theme_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="Safety" Style="{StaticResource SectionTitle}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <CheckBox x:Name="RecycleCheck" Content="Send deleted files to the Recycle Bin by default" Click="Option_Click"/>
                    <TextBlock Style="{StaticResource Subtle}" FontSize="12" Margin="28,0,0,10"
                               Text="Applies to the Disk Analyzer and the duplicate finder. Safer, but the space is only freed once you empty the Recycle Bin."/>
                    <CheckBox x:Name="ConfirmCheck" Content="Ask before reversible changes" Click="Option_Click"/>
                    <TextBlock Style="{StaticResource Subtle}" FontSize="12" Margin="28,0,0,0"
                               Text="For example applying privacy settings or undoing changes. Deleting files and ending processes always asks first."/>
                </StackPanel>
            </Border>

            <TextBlock Text="Updates" Style="{StaticResource SectionTitle}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <CheckBox x:Name="AutoUpdateCheck" Content="Check for a new Kemptly version when the app starts" Click="Option_Click"/>
                    <TextBlock Style="{StaticResource Subtle}" FontSize="12" Margin="28,0,0,10"
                               Text="Off by default. When on, Kemptly asks GitHub for the latest release number. Nothing else is sent, and an update is only downloaded when you click Install."/>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="CheckNowBtn" Content="Check for updates now" Click="CheckNow_Click" Padding="14,6"/>
                        <TextBlock x:Name="UpdateText" Style="{StaticResource Subtle}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="About" Style="{StaticResource SectionTitle}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://application:,,,/Assets/logo.png" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Kemptly" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock x:Name="VersionText" Style="{StaticResource Subtle}"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Subtle}" Margin="0,12,0,12"
                               Text="Free and open source under the MIT license. Kemptly collects no data and runs only while it's open (unless you turn on weekly cleaning)."/>
                    <WrapPanel>
                        <Button Content="Website" Click="Website_Click" Padding="12,5" Margin="0,0,8,8"/>
                        <Button Content="GitHub" Click="GitHub_Click" Padding="12,5" Margin="0,0,8,8"/>
                        <Button Content="Report a bug" Click="Bug_Click" Padding="12,5" Margin="0,0,8,8"/>
                        <Button Content="Open data folder" Click="DataFolder_Click" Padding="12,5" Margin="0,0,8,8"
                                ToolTip="Settings and change history are stored here"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
