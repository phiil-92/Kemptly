<UserControl x:Class="Kemptly.Views.DiskAnalyzerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <DataTemplate x:Key="BarRow">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1" Text="{Binding SizeText}" Margin="12,0,0,0" FontWeight="SemiBold"/>
                <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Value="{Binding Percent, Mode=OneWay}" Maximum="100"
                             Height="4" MinHeight="4" Margin="0,5,0,0"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Disk Analyzer" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource Subtle}"
                       Text="See which folders and files take up the most space. Double-click a folder to dig deeper."/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,16,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Click="Up_Click" Padding="10,6" Margin="0,0,8,0" ToolTip="Parent folder">
                <TextBlock Text="&#xE74A;" Style="{StaticResource Icon}" FontSize="14"/>
            </Button>
            <TextBox x:Name="PathBox" Grid.Column="1" VerticalContentAlignment="Center" KeyDown="PathBox_KeyDown"/>
            <Button Grid.Column="2" Content="Browse…" Click="Browse_Click" Margin="8,0,0,0" Padding="12,6"/>
            <TextBlock Grid.Column="3" Text="Min file size (MB)" VerticalAlignment="Center" Margin="16,0,8,0"/>
            <TextBox x:Name="MinSizeBox" Grid.Column="4" Width="70" Text="100" VerticalContentAlignment="Center"/>
            <Button x:Name="ScanBtn" Grid.Column="5" Content="Scan" Click="Scan_Click" Margin="8,0,0,0" Padding="18,6"
                    Style="{DynamicResource AccentButtonStyle}"/>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <StackPanel x:Name="DrivePanel" Orientation="Horizontal"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ProgressBar x:Name="Busy" Width="120" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusText" Style="{StaticResource Subtle}" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="260"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="8">
                <TabControl BorderThickness="0" Background="Transparent">
                    <TabItem Header="Folders">
                        <ListBox x:Name="FolderList" ItemTemplate="{StaticResource BarRow}" BorderThickness="0"
                                 Background="Transparent" HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 MouseDoubleClick="FolderList_DoubleClick"/>
                    </TabItem>
                    <TabItem Header="File types">
                        <ListBox x:Name="TypeList" ItemTemplate="{StaticResource BarRow}" BorderThickness="0"
                                 Background="Transparent" HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                    </TabItem>
                </TabControl>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Largest files" FontWeight="SemiBold" FontSize="15" Margin="2,0,0,8"/>
                <DataGrid x:Name="FileGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="None" SelectionMode="Extended">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" SortMemberPath="Size" Width="90" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="Modified" Binding="{Binding Modified, StringFormat=d}" Width="95" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="Folder" Binding="{Binding Folder}" Width="3*" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTemplateColumn Width="140" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Show" Click="Show_Click" Padding="8,2" FontSize="12" Margin="0,2,4,2"/>
                                        <Button Content="Delete" Click="Delete_Click" Padding="8,2" FontSize="12" Margin="0,2"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <CheckBox x:Name="RecycleCheck" Grid.Row="2" IsChecked="True" Margin="0,10,0,0"
                          Content="Send deleted files to the Recycle Bin (safer — space is freed once you empty it)"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
