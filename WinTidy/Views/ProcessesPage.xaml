<UserControl x:Class="WinTidy.Views.ProcessesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Processes" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource Subtle}"
                       Text="What's running right now and how much it uses. To stop something from launching again, disable it on the Startup or Services page."/>
        </StackPanel>

        <WrapPanel Grid.Row="1" Style="{StaticResource Toolbar}">
            <TextBox x:Name="SearchBox" Width="240" TextChanged="Search_TextChanged" Margin="0,0,12,0"
                     ToolTip="Filter by name or path"/>
            <CheckBox x:Name="GroupCheck" Content="Group by app" IsChecked="True" Click="Group_Click" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <CheckBox x:Name="AutoCheck" Content="Live update" IsChecked="True" Click="Auto_Click" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Button Content="Refresh" Click="Refresh_Click" Padding="14,6"/>
        </WrapPanel>

        <DataGrid x:Name="ProcGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="None" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="1.2*" ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="#" Binding="{Binding Count}" Width="50" ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn x:Name="CpuCol" Header="CPU" Binding="{Binding CpuText}" SortMemberPath="Cpu" Width="70" ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn x:Name="MemCol" Header="Memory" Binding="{Binding MemoryText}" SortMemberPath="Memory" Width="100" ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="2.5*" ElementStyle="{StaticResource CellText}"/>
                <DataGridTemplateColumn Width="170" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Show" Click="Show_Click" Padding="8,2" FontSize="12" Margin="0,2,4,2"/>
                                <Button Content="End task" Click="Kill_Click" Padding="8,2" FontSize="12" Margin="0,2"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="StatusText" Grid.Row="3" Style="{StaticResource Subtle}" Margin="0,10,0,0"/>
    </Grid>
</UserControl>
