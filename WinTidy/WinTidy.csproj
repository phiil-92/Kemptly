<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\WinTidy.ico</ApplicationIcon>
    <Product>WinTidy</Product>
    <Description>WinTidy — PC cleanup, startup and security manager</Description>
    <AssemblyName>WinTidy</AssemblyName>
    <RootNamespace>WinTidy</RootNamespace>
    <Version>1.0.0</Version>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <!-- WPF0001: Fluent ThemeMode is marked experimental. SYSLIB0057: X509Certificate.CreateFromSignedFile. -->
    <NoWarn>$(NoWarn);WPF0001;SYSLIB0057;CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\WinTidy.ico" />
    <Resource Include="Assets\logo.png" />
    <None Remove="Assets\make-icon.ps1" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.0" />
  </ItemGroup>

</Project>
